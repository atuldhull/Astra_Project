# ASTRA environment configuration
# Copy this file to `.env` and adjust paths for your machine.
# The defaults assume the recommended layout in PROJECT_SPEC.md §19.

# ── Data paths ────────────────────────────────────────────────────────────
# One root for every large artifact: weights, datasets, runs, secrets, uploads.
# Defaults to ~/astra-data if unset. Point it at a fast disk with room to spare
# (and keep it out of OneDrive/Dropbox — training writes thousands of files).
ASTRA_DATA_DIR=~/astra-data

# The rest default to <ASTRA_DATA_DIR>/<name>. Set one only if it lives
# somewhere unusual — e.g. datasets on a second drive.
# ASTRA_DATASETS_DIR=
# ASTRA_WEIGHTS_DIR=
# ASTRA_RUNS_DIR=
# ASTRA_TILES_DIR=
# ASTRA_UPLOADS_DIR=
# ASTRA_SECRETS_DIR=
# ASTRA_ANCHORS_DIR=
# ASTRA_MODELS_DIR=

# ── Model ─────────────────────────────────────────────────────────────────
# Defaults to <ASTRA_WEIGHTS_DIR>/astra-v1.pt and .onnx.
# ASTRA_MODEL_PATH=
# ASTRA_ONNX_PATH=
ASTRA_INFERENCE_DEVICE=cuda:0
ASTRA_IMGSZ=1024
ASTRA_CONF_THRESHOLD=0.25
ASTRA_IOU_THRESHOLD=0.45

# ── Backend ───────────────────────────────────────────────────────────────
ASTRA_BACKEND_HOST=127.0.0.1
ASTRA_BACKEND_PORT=8000
ASTRA_SECRET_KEY=change-me-in-prod-or-at-least-before-demo

# ── Database (docker-compose provides these) ──────────────────────────────
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_DB=astra
POSTGRES_USER=astra
POSTGRES_PASSWORD=astra_dev

# ── Redis ─────────────────────────────────────────────────────────────────
REDIS_HOST=127.0.0.1
REDIS_PORT=6379

# ── Frontend ──────────────────────────────────────────────────────────────
VITE_API_BASE_URL=http://127.0.0.1:8000
VITE_WS_URL=ws://127.0.0.1:8000/ws/live
