# ASTRA environment configuration
# Copy this file to `.env` and adjust paths for your machine.
# The defaults assume the recommended layout in PROJECT_SPEC.md §19.

# ── Data paths (keep OUT of OneDrive) ─────────────────────────────────────
ASTRA_DATA_ROOT=D:/astra-data
ASTRA_DATASETS_DIR=D:/astra-data/datasets
ASTRA_WEIGHTS_DIR=D:/astra-data/weights
ASTRA_RUNS_DIR=D:/astra-data/runs
ASTRA_TILES_DIR=D:/astra-data/tiles
ASTRA_UPLOADS_DIR=D:/astra-data/uploads

# ── Model ─────────────────────────────────────────────────────────────────
ASTRA_MODEL_PATH=D:/astra-data/weights/astra-v1.pt
ASTRA_ONNX_PATH=D:/astra-data/weights/astra-v1.onnx
ASTRA_INFERENCE_DEVICE=cuda:0
ASTRA_IMGSZ=1024
ASTRA_CONF_THRESHOLD=0.25
ASTRA_IOU_THRESHOLD=0.45

# ── Backend ───────────────────────────────────────────────────────────────
ASTRA_BACKEND_HOST=127.0.0.1
ASTRA_BACKEND_PORT=8000
ASTRA_SECRET_KEY=change-me-in-prod-or-at-least-before-demo

# ── Database (docker-compose provides these) ──────────────────────────────
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_DB=astra
POSTGRES_USER=astra
POSTGRES_PASSWORD=astra_dev

# ── Redis ─────────────────────────────────────────────────────────────────
REDIS_HOST=127.0.0.1
REDIS_PORT=6379

# ── Frontend ──────────────────────────────────────────────────────────────
VITE_API_BASE_URL=http://127.0.0.1:8000
VITE_WS_URL=ws://127.0.0.1:8000/ws/live
