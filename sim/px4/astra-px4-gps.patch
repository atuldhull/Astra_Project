 PARAM_DEFINE_INT32(SIM_GPS_USED, 10);
+
+/**
+ * ASTRA: attack model (0 none, 1 denial, 2 intermittent, 3 jump, 4 drag, 6 degrade)
+ *
+ * Test-harness extension (simulator only).
+ * @group Simulator
+ */
+PARAM_DEFINE_INT32(ASTRA_ATK_MODEL, 0);
+
+/**
+ * ASTRA: attack start, seconds after arming
+ *
+ * Test-harness extension (simulator only).
+ * @unit s
+ * @group Simulator
+ */
+PARAM_DEFINE_FLOAT(ASTRA_ATK_ARM_S, 0.0f);
+
+/**
+ * ASTRA: attack duration
+ *
+ * Test-harness extension (simulator only).
+ * @unit s
+ * @group Simulator
+ */
+PARAM_DEFINE_FLOAT(ASTRA_ATK_DUR, 0.0f);
+
+/**
+ * ASTRA: drag-off rate
+ *
+ * Test-harness extension (simulator only).
+ * @unit m/s
+ * @group Simulator
+ */
+PARAM_DEFINE_FLOAT(ASTRA_ATK_RATE, 0.0f);
+
+/**
+ * ASTRA: drag-off bearing
+ *
+ * Test-harness extension (simulator only).
+ * @unit deg
+ * @group Simulator
+ */
+PARAM_DEFINE_FLOAT(ASTRA_ATK_BRG, 0.0f);
+
+/**
+ * ASTRA: drag-off ramp-in time
+ *
+ * Test-harness extension (simulator only).
+ * @unit s
+ * @group Simulator
+ */
+PARAM_DEFINE_FLOAT(ASTRA_ATK_RAMP, 0.0f);
+
+/**
+ * ASTRA: drag-off velocity-consistent (1) or naive (0)
+ *
+ * Test-harness extension (simulator only).
+ * @group Simulator
+ */
+PARAM_DEFINE_INT32(ASTRA_ATK_CONS, 1);
+
+/**
+ * ASTRA: jump offset north
+ *
+ * Test-harness extension (simulator only).
+ * @unit m
+ * @group Simulator
+ */
+PARAM_DEFINE_FLOAT(ASTRA_ATK_JN, 0.0f);
+
+/**
+ * ASTRA: jump offset east
+ *
+ * Test-harness extension (simulator only).
+ * @unit m
+ * @group Simulator
+ */
+PARAM_DEFINE_FLOAT(ASTRA_ATK_JE, 0.0f);
+
+/**
+ * ASTRA: intermittent jamming period
+ *
+ * Test-harness extension (simulator only).
+ * @unit s
+ * @group Simulator
+ */
+PARAM_DEFINE_FLOAT(ASTRA_ATK_PER, 4.0f);
+
+/**
+ * ASTRA: intermittent jamming fraction without fix
+ *
+ * Test-harness extension (simulator only).
+ * @group Simulator
+ */
+PARAM_DEFINE_FLOAT(ASTRA_ATK_DUTY, 0.5f);
+
+/**
+ * ASTRA: 1-sigma Gauss-Markov horizontal position error
+ *
+ * Test-harness extension (simulator only).
+ * @unit m
+ * @group Simulator
+ */
+PARAM_DEFINE_FLOAT(ASTRA_GPS_PNSE, 0.0f);
+
+/**
+ * ASTRA: position error correlation time
+ *
+ * Test-harness extension (simulator only).
+ * @unit s
+ * @group Simulator
+ */
+PARAM_DEFINE_FLOAT(ASTRA_GPS_PTAU, 30.0f);
