+
 	perf_counter_t _loop_perf{perf_alloc(PC_ELAPSED, MODULE_NAME": cycle")};
 
 	DEFINE_PARAMETERS(
-		(ParamInt<px4::params::SIM_GPS_USED>) _sim_gps_used
+		(ParamInt<px4::params::SIM_GPS_USED>) _sim_gps_used,
+		(ParamInt<px4::params::ASTRA_ATK_MODEL>) _astra_model,
+		(ParamFloat<px4::params::ASTRA_ATK_ARM_S>) _astra_arm_s,
+		(ParamFloat<px4::params::ASTRA_ATK_DUR>) _astra_dur,
+		(ParamFloat<px4::params::ASTRA_ATK_RATE>) _astra_rate,
+		(ParamFloat<px4::params::ASTRA_ATK_BRG>) _astra_brg,
+		(ParamFloat<px4::params::ASTRA_ATK_RAMP>) _astra_ramp,
+		(ParamInt<px4::params::ASTRA_ATK_CONS>) _astra_cons,
+		(ParamFloat<px4::params::ASTRA_ATK_JN>) _astra_jn,
+		(ParamFloat<px4::params::ASTRA_ATK_JE>) _astra_je,
+		(ParamFloat<px4::params::ASTRA_ATK_PER>) _astra_per,
+		(ParamFloat<px4::params::ASTRA_ATK_DUTY>) _astra_duty,
+		(ParamFloat<px4::params::ASTRA_GPS_PNSE>) _astra_pnse,
+		(ParamFloat<px4::params::ASTRA_GPS_PTAU>) _astra_ptau
 	)
 };
diff --git a/src/modules/simulation/sensor_gps_sim/parameters.c b/src/modules/simulation/sensor_gps_sim/parameters.c
