 using namespace SITL;
 
+// ASTRA: deterministic, seedable GPS receiver noise (Gauss-Markov position, white velocity).
+namespace {
+struct AstraNoise {
+    bool init;
+    uint32_t s;
+    uint32_t last_ms;
+    float n, e, u;
+};
+AstraNoise astra_noise_state[AP_SIM_MAX_GPS_SENSORS];
+
+float astra_uniform(uint32_t &s)
+{
+    s ^= s << 13;
+    s ^= s >> 17;
+    s ^= s << 5;
+    return ((s >> 8) + 0.5f) * (1.0f / 16777216.0f);
+}
+
+float astra_gauss(uint32_t &s)
+{
+    const float u1 = astra_uniform(s);
+    const float u2 = astra_uniform(s);
+    return sqrtf(-2.0f * logf(u1)) * cosf(2.0f * float(M_PI) * u2);
+}
+
+void astra_apply_noise(GPS_Data &d, uint8_t instance, uint32_t now_ms,
+                       float pos_sigma, float tau, float vel_sigma, int32_t seed)
+{
+    if (instance >= AP_SIM_MAX_GPS_SENSORS) {
+        return;
+    }
+    AstraNoise &ns = astra_noise_state[instance];
+    if (!ns.init) {
+        ns.s = uint32_t(seed) * 2654435761u + 1u + instance;
+        if (ns.s == 0) {
+            ns.s = 1;
+        }
+        ns.n = pos_sigma * astra_gauss(ns.s);
+        ns.e = pos_sigma * astra_gauss(ns.s);
+        ns.u = 1.5f * pos_sigma * astra_gauss(ns.s);
+        ns.last_ms = now_ms;
+        ns.init = true;
+    }
+    const float dt = (now_ms - ns.last_ms) * 0.001f;
+    ns.last_ms = now_ms;
+    const float a = expf(-dt / MAX(1.0f, tau));
+    const float q = pos_sigma * sqrtf(MAX(0.0f, 1.0f - a * a));
+    ns.n = a * ns.n + q * astra_gauss(ns.s);
+    ns.e = a * ns.e + q * astra_gauss(ns.s);
+    ns.u = a * ns.u + 1.5f * q * astra_gauss(ns.s);
+    d.latitude += ns.n / 111319.49079327357;
+    d.longitude += ns.e / (111319.49079327357 * cos(radians(d.latitude)));
+    d.altitude += ns.u;
+    d.speedN += vel_sigma * astra_gauss(ns.s);
+    d.speedE += vel_sigma * astra_gauss(ns.s);
+    d.speedD += 1.5f * vel_sigma * astra_gauss(ns.s);
+}
+} // namespace
+
